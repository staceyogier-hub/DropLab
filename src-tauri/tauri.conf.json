{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DropLab",
  "version": "0.1.0",
  "identifier": "system.adis.droplab",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "DropLab — Airdrop Data Analyser (DRAFT)",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "category": "Utility",
    "shortDescription": "Offline airdrop instrumentation data analyser",
    "longDescription": "DropLab analyses synchronised multi-node airdrop and external-lift instrumentation data fully offline. No data leaves the machine."
  },
  "plugins": {}
}
